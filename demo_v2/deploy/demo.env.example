# TEMPLATE ONLY; never source this file in a shell or copy a LIVE env file.
# Provision /etc/polymarket-demo-v2/demo.env root:root 0600 (not in Git).
# Recommended: provision_env.py prompts privately and writes fresh Argon2id/secret.
DEMO_DATA_DIR=/var/lib/polymarket-demo-v2
DEMO_DB_PATH=/var/lib/polymarket-demo-v2/demo_v2.sqlite3
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD_HASH=
# Optional JSON username-to-Argon2id-hash map, provisioned privately by provision_env.
# No passwords here. Additional accounts share the existing DEMO workspace.
DEMO_AUTH_USERS_JSON={}
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_SECONDS=86400
DEMO_OBSERVATION_MAX_AGE_SECONDS=5
DEMO_DECISION_QUEUE_CAPACITY=1024
DEMO_TELEMETRY_CAPACITY=64
DEMO_PUBLIC_DATA_ENABLED=true
DEMO_RECOVERY_STABILITY_SECONDS=2
DEMO_COOKIE_SECURE=true

# Independent decision/transport budgets; these do not relax quote freshness.
DEMO_DECISION_MAX_QUEUE_DELAY_SECONDS=1
DEMO_TRANSPORT_IDLE_SECONDS=30
DEMO_SNAPSHOT_TIMEOUT_SECONDS=10
# DEMO email delivery is opt-in; do not reuse or source LIVE SMTP configuration.
# Save recipients and notification categories in the authenticated DEMO UI.
DEMO_EMAIL_ENABLED=false
DEMO_EMAIL_FROM=demo@dvirtechnologies.com
DEMO_SMTP_HOST=smtp-relay.gmail.com
DEMO_SMTP_PORT=587
DEMO_SMTP_SECURITY=STARTTLS
# Leave authentication absent for an explicitly IP-authorized Workspace relay.
# If the administrator requires SMTP AUTH, provision both privately:
# DEMO_SMTP_USERNAME=
# DEMO_SMTP_PASSWORD=
