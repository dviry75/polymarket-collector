# TEMPLATE ONLY; never source this file in a shell or copy a LIVE env file.
# Provision /etc/polymarket-demo-v2/demo.env root:root 0600 (not in Git).
# Recommended: provision_env.py prompts privately and writes fresh Argon2id/secret.
DEMO_DATA_DIR=/var/lib/polymarket-demo-v2
DEMO_DB_PATH=/var/lib/polymarket-demo-v2/demo_v2.sqlite3
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD_HASH=
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_SECONDS=86400
DEMO_OBSERVATION_MAX_AGE_SECONDS=5
DEMO_DECISION_QUEUE_CAPACITY=1024
DEMO_TELEMETRY_CAPACITY=64
DEMO_PUBLIC_DATA_ENABLED=true
DEMO_RECOVERY_STABILITY_SECONDS=2
DEMO_COOKIE_SECURE=true
