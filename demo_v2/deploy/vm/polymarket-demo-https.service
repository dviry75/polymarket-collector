[Unit]
Description=HTTPS-only public ingress for isolated Polymarket DEMO VM
Wants=network-online.target
After=network-online.target polymarket-demo-vm.service
ConditionPathExists=/etc/polymarket-demo-vm/writer-in-vm

[Service]
Type=notify
User=polymarket-demo-https
DynamicUser=yes
StateDirectory=polymarket-demo-https
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/polymarket-demo-https/data
Environment=XDG_CONFIG_HOME=/var/lib/polymarket-demo-https/config
Environment=GOMEMLIMIT=128MiB
ExecStartPre=/usr/bin/caddy validate --config /etc/polymarket-demo-https/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /etc/polymarket-demo-https/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=128
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
