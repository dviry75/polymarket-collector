[Unit]
Description=DNS relay for isolated Polymarket DEMO VM
Requires=polymarket-demo-vm-network.service
After=polymarket-demo-vm-network.service systemd-resolved.service
BindsTo=polymarket-demo-vm-network.service
Before=polymarket-demo-vm.service

[Service]
Type=simple
User=polymarket-demo-dns
Group=polymarket-demo-dns
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null --no-hosts --no-resolv --server=127.0.0.53 --listen-address=172.31.250.1 --bind-interfaces --pid-file=/run/polymarket-demo-vm-dns/dnsmasq.pid --log-facility=-
Restart=on-failure
RestartSec=5
RuntimeDirectory=polymarket-demo-vm-dns
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# dnsmasq uses read-only netlink queries to enumerate its bound interfaces.
# AF_NETLINK grants no network administration capability.
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=172.31.250.0/30
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
