[Unit]
Description=Isolated Polymarket DEMO virtual machine
Requires=polymarket-demo-vm-network.service polymarket-demo-vm-dns.service
After=polymarket-demo-vm-network.service polymarket-demo-vm-dns.service
BindsTo=polymarket-demo-vm-network.service
ConditionPathExists=/dev/kvm

[Service]
Type=simple
User=polymarket-demo-vm
Group=polymarket-demo-vm
SupplementaryGroups=kvm
ExecStart=/usr/bin/qemu-system-x86_64 -name polymarket-demo-vm -machine q35,accel=kvm -cpu host -m 1536 -smp 2 -drive file=/var/lib/polymarket-demo-vm/disk.qcow2,if=virtio,format=qcow2 -drive file=/var/lib/polymarket-demo-vm/seed.iso,media=cdrom,format=raw,readonly=on -netdev tap,id=demo,ifname=demo-tap0,script=no,downscript=no,vhost=off -device virtio-net-pci,netdev=demo,mac=52:54:00:de:02:01 -display none -serial file:/var/log/polymarket-demo-vm/serial.log -qmp unix:/run/polymarket-demo-vm/qmp.sock,server=on,wait=off -monitor none
ExecStop=/usr/bin/python3 -B /usr/local/lib/polymarket-demo-vm/poweroff.py $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
RuntimeDirectory=polymarket-demo-vm
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/var/lib/polymarket-demo-vm /var/log/polymarket-demo-vm
MemoryHigh=1800M
MemoryMax=2200M
TasksMax=64
CPUQuota=200%

[Install]
WantedBy=multi-user.target
