# Existing collector defaults
COINBASE_CANDLES_URL=https://api.exchange.coinbase.com/products/{product_id}/candles
COINBASE_PRODUCT_ID=BTC-USD
COINBASE_CANDLE_GRANULARITY_SECONDS=300
COINBASE_VOLUME_POLL_INTERVAL_SECONDS=30
COINBASE_REQUEST_TIMEOUT_SECONDS=10
COINBASE_MAX_DELTA_GAP_SECONDS=90
COINBASE_MISSING_CANDLE_RETRY_COUNT=2
COINBASE_MISSING_CANDLE_RETRY_DELAY_SECONDS=2

# LIVE standalone service safe defaults
TRADING_MODE=DEMO
LIVE_MODULE_ENABLED=false
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_ADAPTER=mock
LIVE_KILL_SWITCH=true
LIVE_PUBLIC_BASE_URL=https://live-poly.dvirtechnologies.com
LIVE_DB_PATH=/opt/polymarket-btc-live/poly_live.sqlite3
LIVE_BACKUP_DIR=/opt/polymarket-btc-live/backups
LIVE_BACKUP_RETENTION_DAYS=7
LIVE_BACKUP_MAX_TOTAL_BYTES=1073741824
LIVE_BACKUP_WARNING_THRESHOLD_PERCENT=80
LIVE_DEFAULT_TRADE_AMOUNT_USD=1
LIVE_MAX_TRADE_AMOUNT_USD=1
LIVE_MAX_TOTAL_EXPOSURE_USD=3
LIVE_MAX_OPEN_DEALS=3
LIVE_MAX_OPEN_ORDERS=3
LIVE_MAX_ACTIVE_RULES=1
LIVE_MAX_DAILY_REALIZED_LOSS_USD=10
LIVE_MAX_CONSECUTIVE_FAILED_ORDERS=3
LIVE_MAX_CONSECUTIVE_LOSING_DEALS=5
LIVE_ENTRY_ORDER_TYPE=FOK
LIVE_PARTIAL_FILLS_ALLOWED=false
LIVE_MAX_ENTRY_SLIPPAGE=0.01
LIVE_STOP_LOSS_ORDER_TYPE=FAK
LIVE_STOP_LOSS_INITIAL_SLIPPAGE=0.02
LIVE_MAX_EXIT_SLIPPAGE=0.05
LIVE_MAX_STOP_LOSS_ATTEMPTS=3
LIVE_STOP_LOSS_RETRY_DELAY_MS=500
LIVE_REDEMPTION_MODE=manual
LIVE_MOCK_SCENARIO=filled
LIVE_MARKET_DATA_STALE_AFTER_SECONDS=5
LIVE_USER_STATE_STALE_AFTER_SECONDS=15
LIVE_RECONCILIATION_MAX_AGE_SECONDS=30
LIVE_RECONCILIATION_INTERVAL_SECONDS=15

# Login protects every /live route. Store real values outside Git.
LIVE_LOGIN_USERNAME=Admin@system.com
LIVE_LOGIN_PASSWORD_HASH=
LIVE_SESSION_SECRET=
LIVE_SESSION_TTL_SECONDS=0
LIVE_LOGIN_RATE_LIMIT_PER_MINUTE=5

# Set this to enable operator POST actions under /live after login.
# Do not put the real value in Git.
LIVE_OPERATOR_TOKEN=

# Future account integration placeholders only. Do not commit real values.
POLYMARKET_PROFILE_ADDRESS=
POLYMARKET_ACCOUNT_LOGIN_TYPE=email
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_EXPECTED_WALLET_ADDRESS=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
GOOGLE_CLOUD_PROJECT=
GOOGLE_SECRET_MANAGER_PREFIX=
