# Existing collector defaults
COINBASE_CANDLES_URL=https://api.exchange.coinbase.com/products/{product_id}/candles
COINBASE_PRODUCT_ID=BTC-USD
COINBASE_CANDLE_GRANULARITY_SECONDS=300
COINBASE_VOLUME_POLL_INTERVAL_SECONDS=30
COINBASE_REQUEST_TIMEOUT_SECONDS=10
COINBASE_MAX_DELTA_GAP_SECONDS=90
COINBASE_MISSING_CANDLE_RETRY_COUNT=2
COINBASE_MISSING_CANDLE_RETRY_DELAY_SECONDS=2

# LIVE module safe defaults
TRADING_MODE=DEMO
LIVE_MODULE_ENABLED=false
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_ADAPTER=mock
LIVE_KILL_SWITCH=true
LIVE_DEFAULT_TRADE_AMOUNT_USD=1
LIVE_MAX_TRADE_AMOUNT_USD=1
LIVE_MAX_TOTAL_EXPOSURE_USD=3
LIVE_MAX_OPEN_DEALS=3
LIVE_MAX_OPEN_ORDERS=3
LIVE_ENTRY_ORDER_TYPE=FOK
LIVE_PARTIAL_FILLS_ALLOWED=false
LIVE_MAX_ENTRY_SLIPPAGE=0.01
LIVE_MAX_EXIT_SLIPPAGE=0.02
LIVE_REDEMPTION_MODE=manual
LIVE_MOCK_SCENARIO=filled

# Set this to enable operator write actions under /live.
# Do not put the real value in Git.
LIVE_OPERATOR_TOKEN=

# Future account integration placeholders only. Do not commit real values.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_EXPECTED_WALLET_ADDRESS=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

