# Dashboard-only configuration. Never place trading API credentials or a
# private signing key in this file.
TRADING_MODE=LIVE
LIVE_EXECUTION_MODE=READ_ONLY
LIVE_MODULE_ENABLED=false
LIVE_ADAPTER=polymarket
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_KILL_SWITCH=true
LIVE_PAUSE_ENTRIES=true
LIVE_CANARY_ARMED=false
LIVE_CONTINUOUS_TRADING_ENABLED=false
POLYMARKET_MARKET_WS_ENABLED=false
POLYMARKET_USER_WS_ENABLED=false
LIVE_DB_PATH=/opt/polymarket-btc-live/poly_live.sqlite3
LIVE_TRADER_SOCKET_PATH=/run/polymarket/trader.sock
LIVE_PUBLIC_BASE_URL=https://live-poly.dvirtechnologies.com
LIVE_LOGIN_USERNAME=Admin@system.com
LIVE_SESSION_TTL_SECONDS=0
# Required Dashboard-only secrets (no operator token or trading credentials):
# LIVE_LOGIN_PASSWORD_HASH, LIVE_SESSION_SECRET
LIVE_ENVIRONMENT=LIVE
LIVE_STRATEGY_ID=btc-updown-5m
LIVE_STRATEGY_VERSION=dashboard-v1
LIVE_PROVENANCE_SOURCE=TRADER
