# Non-secret Finland LIVE service configuration.
# All credentials use GCP Secret Manager and are loaded into process memory only.
TRADING_MODE=LIVE
LIVE_EXECUTION_MODE=PAPER_TRADING
LIVE_PAPER_TRADING_ENABLED=true
LIVE_MODULE_ENABLED=true
LIVE_ADAPTER=polymarket
LIVE_KILL_SWITCH=true
LIVE_PAUSE_ENTRIES=true
LIVE_CANARY_ARMED=false
LIVE_CONTINUOUS_TRADING_ENABLED=false
LIVE_CANARY_EVENT_LIMIT=1
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false

POLYMARKET_MARKET_WS_ENABLED=true
POLYMARKET_USER_WS_ENABLED=true
LIVE_RAW_MARKET_WS_PAYLOADS_ENABLED=false
LIVE_SNAPSHOT_MIN_INTERVAL_SECONDS=10
LIVE_MARKET_WS_INGRESS_QUEUE_CAPACITY=32
LIVE_MARKET_WS_LIBRARY_QUEUE_HIGH_WATER=256
LIVE_MARKET_WS_LIBRARY_QUEUE_LOW_WATER=64
LIVE_SNAPSHOT_RETENTION_DAYS=30
LIVE_ARCHIVE_RETENTION_DAYS=365
LIVE_ARCHIVE_GCS_BUCKET=
LIVE_ARCHIVE_GCS_PREFIX=polymarket-live/snapshots
LIVE_MARKET_DISCOVERY_INTERVAL_SECONDS=5

LIVE_DEFAULT_TRADE_AMOUNT_USD=5
LIVE_MAX_TRADE_AMOUNT_USD=5
LIVE_MAX_TOTAL_EXPOSURE_USD=5
LIVE_MAX_TRADE_TOKENS=5
LIVE_MAX_OPEN_DEALS=1
LIVE_MAX_OPEN_ORDERS=2
LIVE_MAX_ACTIVE_RULES=1
LIVE_ENTRY_ORDER_TYPE=FAK
LIVE_PARTIAL_FILLS_ALLOWED=true
LIVE_STRATEGY_ENTRY_PRICE=0.74
LIVE_STRATEGY_ENTRY_MAX_PRICE=0.76
LIVE_STRATEGY_TAKE_PROFIT_PRICE=0.96
LIVE_STRATEGY_STOP_PRICE=0.66
LIVE_STRATEGY_EMERGENCY_PRICE=0.60
LIVE_STRATEGY_STOP_MIN_PRICE=0.55
LIVE_STRATEGY_EMERGENCY_MIN_PRICE=0.55
LIVE_STRATEGY_ENTRY_WINDOW_SECONDS=120
LIVE_STOP_LOSS_ORDER_TYPE=GTC
LIVE_ORDER_HEARTBEAT_INTERVAL_SECONDS=5
LIVE_RECONCILIATION_ACTIVE_INTERVAL_SECONDS=3
LIVE_RECONCILIATION_INTERVAL_SECONDS=15
LIVE_RECONCILIATION_MAX_AGE_SECONDS=30
LIVE_MARKET_DATA_STALE_AFTER_SECONDS=1
LIVE_REDEMPTION_MODE=manual

LIVE_PUBLIC_BASE_URL=https://live-poly.dvirtechnologies.com
LIVE_DB_PATH=/opt/polymarket-btc-live/poly_live.sqlite3
LIVE_TRADER_SOCKET_PATH=/run/polymarket/trader.sock
LIVE_BACKUP_DIR=/opt/polymarket-btc-live/backups
LIVE_BACKUP_RETENTION_DAYS=7
LIVE_BACKUP_MAX_TOTAL_BYTES=1073741824
LIVE_BACKUP_WARNING_THRESHOLD_PERCENT=80
LIVE_LOGIN_USERNAME=Admin@system.com
LIVE_SESSION_TTL_SECONDS=0
POLYMARKET_PROFILE_ADDRESS=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_ACCOUNT_LOGIN_TYPE=email
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
GOOGLE_CLOUD_PROJECT=
GOOGLE_SECRET_MANAGER_PREFIX=polymarket-live
POLYMARKET_PRIVATE_KEY_SECRET_VERSION=1
LIVE_PRIVATE_SIGNING_READINESS_ENABLED=false

# Required Secret Manager suffixes (no values in this file):
# POLYMARKET_PRIVATE_KEY, POLYMARKET_API_KEY, POLYMARKET_API_SECRET,
# POLYMARKET_API_PASSPHRASE, LIVE_LOGIN_PASSWORD_HASH,
# LIVE_SESSION_SECRET, LIVE_OPERATOR_TOKEN.
